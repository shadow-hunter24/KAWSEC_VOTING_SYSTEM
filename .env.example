# ── Supabase (required) ───────────────────────────────────────────────────────
# VITE_SUPABASE_URL
#   Your Supabase project URL.
#   Found in: Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=your_supabase_project_url

# VITE_SUPABASE_PUBLISHABLE_KEY
#   Your Supabase anon (public) key. Safe to include in the browser bundle.
#   Found in: Supabase Dashboard → Project Settings → API → anon public
#   NEVER use the service-role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# ── Edge Function secrets (NOT set here) ─────────────────────────────────────
# The following secrets are injected by Supabase automatically into every
# Edge Function — you do not set them in .env:
#   SUPABASE_URL              — same as VITE_SUPABASE_URL above
#   SUPABASE_SERVICE_ROLE_KEY — the service-role key (never expose to browser)
#
# Optional Edge Function secret (set in Supabase Dashboard → Edge Functions → Secrets):
#   ALLOWED_ORIGIN            — restrict CORS to your production domain
#                               e.g. https://vote.kawsec.edu.gh
#                               Leave unset to allow all origins (development only)
